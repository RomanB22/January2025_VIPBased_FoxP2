	//oriMed2  all.append()
	//oriDist2 all.append()
}

proc geom() {
	forsec all {  }
	soma     {  L = 20   diam = 10  }
	rad1     {  L = 300  diam = 3   }
	rad2     {  L = 300  diam = 3   }
	ori1     {  L = 150  diam = 1.5 }
	ori2     {  L = 150  diam = 1.5 }
	//radProx1 {  L = 50   diam = 4   }
	//radMed1  {  L = 50   diam = 3   }
	//radDist1 {  L = 100  diam = 2   }
	//lmM1     {  L = 50   diam = 1.5 }
	//lmt1     {  L = 50   diam = 1   }
	//radProx2 {  L = 50   diam = 4   }
	//radMed2  {  L = 50   diam = 3   }
	//radDist2 {  L = 100  diam = 2   }
	//lmM2     {  L = 50   diam = 1.5 }
	//lmt2     {  L = 50   diam = 1   }	
	//oriProx1 {  L = 50   diam = 2   }
	//oriMed1  {  L = 50   diam = 1.5 }
	//oriDist1 {  L = 50   diam = 1   }
	//oriProx2 {  L = 50   diam = 2   }
	//oriMed2  {  L = 50   diam = 1.5 }
	//oriDist2 {  L = 50   diam = 1   }
}

external lambda_f
proc geom_nseg() {
  forsec all { nseg = 1 }//int((L/(0.1*lambda_f(100))+.9)/2)*2 + 1  }
}

proc biophys() {
    valf = -13 // -13 (old), -29 (depol block)
	soma {
		soma_nafcr   = 0.007048106046995259
	    soma_kdrcr   = 0.011213668755840124
	    soma_Kslowcr = 0.007200984292049982
	    soma_iCcr    = 9.857697126917098e-05
	    soma_cancr   = 0.007336735493465247
	    v_initcr     = -77

		insert pas
		cm       = 1.3           //microF/cm2
		g_pas    = 2e-4
		e_pas    = v_initcr
		Ra       = 150

		insert Nafcr 
		gnafbar_Nafcr= soma_nafcr

		//insert hin // It is a detail to reproduce the return to baseline better
		//gbar_hin = 5e-5

		insert kdrcr
		gkdrbar_kdrcr= soma_kdrcr
		valf_kdrcr=valf

		insert IKscr
		gKsbar_IKscr= soma_Kslowcr

		insert iCcr
		gkcbar_iCcr= soma_iCcr

		insert cancr
		gcabar_cancr=soma_cancr

		insert cadyn
		// TO DO: cadyn_new, compile,insert, and verify the validation tests
	}

	rad1 {
		insert pas
		cm       = 1           //microF/cm2
		g_pas    = 1e-4
		v_initcr = -77
		e_pas    = v_initcr
		Ra       = 150

		insert Nafcr
		gnafbar_Nafcr = 0.11257336429562881

		insert kdrcr
		gkdrbar_kdrcr = 0.01347170651215512
		valf_kdrcr=valf
	}

	rad2 {
		insert pas
		cm       = 1          //microF/cm2
		g_pas    = 1e-4
		v_initcr = -77
		e_pas    = v_initcr
		Ra       = 150

		insert Nafcr
		gnafbar_Nafcr = 0.10999874642906309

		insert kdrcr
		gkdrbar_kdrcr = 0.010863187066404151
		valf_kdrcr=valf
	}	

	ori1 {
		insert pas
		cm       = 1            //microF/cm2
		g_pas    = 1e-4
		v_initcr = -77
		e_pas    = v_initcr
		Ra       = 150

		insert Nafcr
		gnafbar_Nafcr = 0.04082054365113535

		insert kdrcr
		gkdrbar_kdrcr = 0.00795423100785642
		valf_kdrcr=valf
	}

	ori2 {
		insert pas
		cm       = 1            //microF/cm2
		g_pas    = 1e-4
		v_initcr = -77
		e_pas    = v_initcr
		Ra       = 150

		insert Nafcr
		gnafbar_Nafcr = 0.025482710904591584

		insert kdrcr
		gkdrbar_kdrcr = 0.009008968739102362
		valf_kdrcr=valf
	}

	forsec all {
		ko0_k_ion = 3.82   //mM
	 	ki0_k_ion = 140    //mM
		celsius   = 23
	} 					

}

func is_art() { return 0 }

objref zz
zz = new Impedance()

func rn() { local rn
  init()  // make sure all changes to g, c, ri etc. have taken effect
  soma zz.loc(0.5)  // sets origin for impedance calculations to middle of soma
  zz.compute(0)  // DC input R
  soma { rn = zz.input(0.5) }  // rn is input R at middle of the soma
  return rn
}

print "DC input resistance of cell is ", rn(), "megohms"

proc totalarea() { local sum
  finitialize()
  sum = 0
  forall for (x,0) sum += area(x)
  print "total surface area = ", sum, " um2"
}

totalarea() // returns total surface area

func totalcm() { local tmp
  tmp = 0
  forall for (x,0) tmp += area(x)*cm(x)/10^8
  return tmp*10^6
}

print "Total Capacitance of cell is ", totalcm(), "pF"


endtemplate FoxP2


