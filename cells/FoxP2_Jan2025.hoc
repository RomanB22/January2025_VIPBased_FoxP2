    //oriMed1  all.append()
    //oriDist1 all.append()
    //oriProx2 all.append()
    //oriMed2  all.append()
    //oriDist2 all.append()
}

proc geom() {
    forsec all {  }
    soma     {  L = 20   diam = 10  }
    rad1     {  L = 300  diam = 3   }
    rad2     {  L = 300  diam = 3   }
    ori1     {  L = 150  diam = 1.5 }
    ori2     {  L = 150  diam = 1.5 }
    //radProx1 {  L = 50   diam = 4   }
    //radMed1  {  L = 50   diam = 3   }
    //radDist1 {  L = 100  diam = 2   }
    //lmM1     {  L = 50   diam = 1.5 }
    //lmt1     {  L = 50   diam = 1   }
    //radProx2 {  L = 50   diam = 4   }
    //radMed2  {  L = 50   diam = 3   }
    //radDist2 {  L = 100  diam = 2   }
    //lmM2     {  L = 50   diam = 1.5 }
    //lmt2     {  L = 50   diam = 1   }
    //oriProx1 {  L = 50   diam = 2   }
    //oriMed1  {  L = 50   diam = 1.5 }
    //oriDist1 {  L = 50   diam = 1   }
    //oriProx2 {  L = 50   diam = 2   }
    //oriMed2  {  L = 50   diam = 1.5 }
    //oriDist2 {  L = 50   diam = 1   }
}

external lambda_f
proc geom_nseg() {
  forsec all { nseg = 1 }//int((L/(0.1*lambda_f(100))+.9)/2)*2 + 1  }
}

proc biophys() {
    valf = -13 // -13 (old), -29 (depol block)
    soma {
        soma_nafcr   = 0.00792241108927046
        soma_kdrcr   = 0.017264335382227255
        soma_Kslowcr = 0.004999550461485062
        soma_iCcr    = 0.00010672629071301523
        soma_cancr   = 0.009041149398789038
        v_initcr     = -66.36873979773242

       insert pas
       cm       = 2.0750330942221358           //microF/cm2
       g_pas    = 4.332376755670617e-06
       e_pas    = v_initcr
       Ra       = 115.43187325932695

       insert Nafcr
       gnafbar_Nafcr= soma_nafcr

       //insert hin // It is a detail to reproduce the return to baseline better
       //gbar_hin = 5e-5

       insert kdrcr
       gkdrbar_kdrcr= soma_kdrcr
       valf_kdrcr=valf

       insert IKscr
       gKsbar_IKscr= soma_Kslowcr

       insert iCcr
       gkcbar_iCcr= soma_iCcr

       insert cancr
       gcabar_cancr=soma_cancr

       insert cadyn
       // TO DO: cadyn_new, compile,insert, and verify the validation tests
    }

    rad1 {
       insert pas
       cm       = 3.133558790101724           //microF/cm2
       g_pas    = 9.211499195069896e-05
       v_initcr = -72.61032815286347
       e_pas    = v_initcr
       Ra       = 111.19659944041622

       insert Nafcr
       gnafbar_Nafcr = 0.09609176242393565

       insert kdrcr
       gkdrbar_kdrcr = 0.016011530234952602
       valf_kdrcr=valf
    }

    rad2 {
       insert pas
       cm       = 2.064580707959245         //microF/cm2
       g_pas    = 6.254791049107461e-05
       v_initcr = -69.99699610107999
       e_pas    = v_initcr
       Ra       = 111.76668505024826

       insert Nafcr
       gnafbar_Nafcr = 0.12820290017177124

       insert kdrcr
       gkdrbar_kdrcr = 0.011384794197403585
       valf_kdrcr=valf
    }

    ori1 {
       insert pas
       cm       = 1.5176378820670497            //microF/cm2
       g_pas    = 5.257002446478203e-06
       v_initcr = -54.2289806909487
       e_pas    = v_initcr
       Ra       = 94.74718339461782

       insert Nafcr
       gnafbar_Nafcr = 0.029965488148624903

       insert kdrcr
       gkdrbar_kdrcr = 0.006694501704851497
       valf_kdrcr=valf
    }

    ori2 {
       insert pas
       cm       = 2.15072603453916            //microF/cm2
       g_pas    = 1.4278457683822263e-05
       v_initcr = -63.62680070683853
       e_pas    = v_initcr
       Ra       = 132.73532224173897

       insert Nafcr
       gnafbar_Nafcr = 0.038223933270564815

       insert kdrcr
       gkdrbar_kdrcr = 0.010723434637928886
       valf_kdrcr=valf
    }

    forsec all {
       ko0_k_ion = 3.82   //mM
       ki0_k_ion = 140    //mM
       celsius   = 23
    }

}

func is_art() { return 0 }

objref zz
zz = new Impedance()

func rn() { local rn
  init()  // make sure all changes to g, c, ri etc. have taken effect
  soma zz.loc(0.5)  // sets origin for impedance calculations to middle of soma
  zz.compute(0)  // DC input R
  soma { rn = zz.input(0.5) }  // rn is input R at middle of the soma
  return rn
}

print "DC input resistance of cell is ", rn(), "megohms"

proc totalarea() { local sum
  finitialize()
  sum = 0
  forall for (x,0) sum += area(x)
  print "total surface area = ", sum, " um2"
}

totalarea() // returns total surface area

func totalcm() { local tmp
  tmp = 0
  forall for (x,0) tmp += area(x)*cm(x)/10^8
  return tmp*10^6
}

print "Total Capacitance of cell is ", totalcm(), "pF"


endtemplate FoxP2


