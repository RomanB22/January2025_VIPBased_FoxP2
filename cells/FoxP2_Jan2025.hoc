// Artificial cells no longer need a default section.
//Network cell templates
//   VIPCell
// Simplified version (BPG 27-9-08)
//  - geometry and channels from Santhakumar et al 2005
//  - geometry modified to preserve VCUs different dendrites
// Parameters modified to calibrate V1 FoxP2 spinal cord interneuron (01-24-2025)

global_lambda_f = 1
  func lambda_f() {return global_lambda_f}

begintemplate FoxP2
public is_art
public init, topol, basic_shape, subsets, geom, biophys
public pre_list, connect2target

public soma
public rad1     // public radProx1, radMed1, radDist1, lmM1, lmt1
public rad2     // public radProx2, radMed2, radDist2, lmM2, lmt2
public ori1     // public oriProx1, oriMed1, oriDist1
public ori2     // public oriProx2, oriMed2, oriDist2
public all

objref pre_list

proc init() {
    topol()
    subsets()
    geom()
    biophys()
    geom_nseg()
}

create soma
create rad1     // create radProx1, radMed1, radDist1, lmM1, lmt1
create rad2     // create radProx2, radMed2, radDist2, lmM2, lmt2
create ori1     // create oriProx1, oriMed1, oriDist1
create ori2     // create oriProx2, oriMed2, oriDist2

proc topol() { local i
    connect rad1(0), soma(0)
    connect rad2(0), soma(1)
    connect ori1(0), soma(0)
    connect ori2(0), soma(1)
}

objref all
proc subsets() { local i
    objref all
    all = new SectionList()
    soma     all.append()
    rad1     all.append()
    rad2     all.append()
    ori1     all.append()
    ori2     all.append()
}

proc geom() {
    forsec all {  }
    soma     {  L = 20   diam = 10  }
    rad1     {  L = 300  diam = 3   }
    rad2     {  L = 300  diam = 3   }
    ori1     {  L = 150  diam = 1.5 }
    ori2     {  L = 150  diam = 1.5 }
}

external lambda_f
proc geom_nseg() {
  forsec all { nseg = 1 }//int((L/(0.1*lambda_f(100))+.9)/2)*2 + 1  }
}

proc biophys() {
ori1_IKscr_gKsbar = 0.0
ori1_Nafcr_gnafbar = 0.03620051664945352
ori1_Nafcr_taus = 209.6402667869049
ori1_Ra = 156.48488866793994
ori1_cancr_gcabar = 0.0
ori1_cm = 0.9862606024212732
ori1_iCcr_gkcbar = 0.0
ori1_kdrcr_gkdrbar = 0.007620749947248059
ori1_kdrcr_valf = -11.238475569220446
ori1_pas_e = -68.94520281296299
ori1_pas_g = 4.9690008977514214e-05
ori2_IKscr_gKsbar = 0.0
ori2_Nafcr_gnafbar = 0.04637756634393874
ori2_Nafcr_taus = 195.75000066315047
ori2_Ra = 149.16544292366643
ori2_cancr_gcabar = 0.0
ori2_cm = 0.894380975574114
ori2_iCcr_gkcbar = 0.0
ori2_kdrcr_gkdrbar = 0.001989049667110744
ori2_kdrcr_valf = -11.991581787070174
ori2_pas_e = -82.55328942703039
ori2_pas_g = 5.9458077693878924e-05
rad1_IKscr_gKsbar = 0.0
rad1_Nafcr_gnafbar = 0.0383372229380183
rad1_Nafcr_taus = 200.03659251492624
rad1_Ra = 139.1751560040922
rad1_cancr_gcabar = 0.0
rad1_cm = 0.7800140087280175
rad1_iCcr_gkcbar = 0.0
rad1_kdrcr_gkdrbar = 0.0027802038807920797
rad1_kdrcr_valf = -15.416421652927266
rad1_pas_e = -39.834587008644164
rad1_pas_g = 4.512702470327495e-05
rad2_IKscr_gKsbar = 0.0
rad2_Nafcr_gnafbar = 0.007115974529340965
rad2_Nafcr_taus = 213.42669283460768
rad2_Ra = 141.7078212258808
rad2_cancr_gcabar = 0.0
rad2_cm = 1.207283724387104
rad2_iCcr_gkcbar = 0.0
rad2_kdrcr_gkdrbar = 0.006604210608652641
rad2_kdrcr_valf = -13.073161566111239
rad2_pas_e = -53.397303942965394
rad2_pas_g = 5.481073970515329e-05
soma_IKscr_gKsbar = 0.0
soma_Nafcr_gnafbar = 0.029258105672312417
soma_Nafcr_taus = 208.46441586035667
soma_Ra = 135.11537924391862
soma_cancr_gcabar = 0.001200673446931951
soma_cm = 0.1762111618060807
soma_iCcr_gkcbar = 0.002739309869536659
soma_kdrcr_gkdrbar = 0.002731219341601073
soma_kdrcr_valf = -11.792996540097391
soma_pas_e = -74.63132881332893
soma_pas_g = 2.98701167732318e-05

    soma {
       insert pas
       cm  = soma_cm           //microF/cm2
       g_pas    = soma_pas_g
       e_pas    = soma_pas_e
       Ra       = soma_Ra

       insert Nafcr
       gnafbar_Nafcr= soma_Nafcr_gnafbar
       taus_Nafcr = soma_Nafcr_taus

       //insert hin // It is a detail to reproduce the return to baseline better
       //gbar_hin = 5e-5

       insert kdrcr
       gkdrbar_kdrcr= soma_kdrcr_gkdrbar
       valf_kdrcr=soma_kdrcr_valf

       insert IKscr
       gKsbar_IKscr= soma_IKscr_gKsbar

       insert iCcr
       gkcbar_iCcr= soma_iCcr_gkcbar

       insert cancr
       gcabar_cancr=soma_cancr_gcabar

       insert cadyn
    }

    rad1 {
       insert pas
       cm       = rad1_cm           //microF/cm2
       g_pas    = rad1_pas_g
       e_pas    = rad1_pas_e
       Ra       = rad1_Ra

       insert Nafcr
       gnafbar_Nafcr= rad1_Nafcr_gnafbar
       taus_Nafcr = rad1_Nafcr_taus

       insert kdrcr
       gkdrbar_kdrcr = rad1_kdrcr_gkdrbar
       valf_kdrcr=rad1_kdrcr_valf

       insert IKscr
       gKsbar_IKscr= rad1_IKscr_gKsbar

       insert iCcr
       gkcbar_iCcr= rad1_iCcr_gkcbar

       insert cancr
       gcabar_cancr=rad1_cancr_gcabar

       insert cadyn
    }

    rad2 {
       insert pas
       cm       = rad2_cm         //microF/cm2
       g_pas    = rad2_pas_g
       e_pas    = rad2_pas_e
       Ra       = rad2_Ra

       insert Nafcr
       gnafbar_Nafcr= rad2_Nafcr_gnafbar
       taus_Nafcr = rad2_Nafcr_taus

       insert IKscr
       gKsbar_IKscr= rad2_IKscr_gKsbar

       insert kdrcr
       gkdrbar_kdrcr = rad2_kdrcr_gkdrbar
       valf_kdrcr=rad2_kdrcr_valf

       insert iCcr
       gkcbar_iCcr= rad2_iCcr_gkcbar

       insert cancr
       gcabar_cancr=rad2_cancr_gcabar

       insert cadyn
    }

    ori1 {
       insert pas
       cm       = ori1_cm            //microF/cm2
       g_pas    = ori1_pas_g
       e_pas    = ori1_pas_e
       Ra       = ori1_Ra

       insert Nafcr
       gnafbar_Nafcr= ori1_Nafcr_gnafbar
       taus_Nafcr = ori1_Nafcr_taus

       insert kdrcr
       gkdrbar_kdrcr = ori1_kdrcr_gkdrbar
       valf_kdrcr=ori1_kdrcr_valf

       insert IKscr
       gKsbar_IKscr= ori1_IKscr_gKsbar

       insert iCcr
       gkcbar_iCcr= ori1_iCcr_gkcbar

       insert cancr
       gcabar_cancr= ori1_cancr_gcabar

       insert cadyn
    }

    ori2 {
       insert pas
       cm       = ori2_cm            //microF/cm2
       g_pas    = ori2_pas_g
       e_pas    = ori2_pas_e
       Ra       = ori2_Ra

       insert Nafcr
       gnafbar_Nafcr= ori2_Nafcr_gnafbar
       taus_Nafcr = ori2_Nafcr_taus

       insert kdrcr
       gkdrbar_kdrcr = ori2_kdrcr_gkdrbar
       valf_kdrcr=ori2_kdrcr_valf

       insert IKscr
       gKsbar_IKscr= ori2_IKscr_gKsbar

       insert iCcr
       gkcbar_iCcr= ori2_iCcr_gkcbar

       insert cancr
       gcabar_cancr= ori2_cancr_gcabar

       insert cadyn
    }

    forsec all {
       ko0_k_ion = 3.82   //mM
       ki0_k_ion = 140    //mM
       celsius   = 23
    }

}

func is_art() { return 0 }

objref zz
zz = new Impedance()

func rn() { local rn
  init()  // make sure all changes to g, c, ri etc. have taken effect
  soma zz.loc(0.5)  // sets origin for impedance calculations to middle of soma
  zz.compute(0)  // DC input R
  soma { rn = zz.input(0.5) }  // rn is input R at middle of the soma
  return rn
}

print "DC input resistance of cell is ", rn(), "megohms"

proc totalarea() { local sum
  finitialize()
  sum = 0
  forall for (x,0) sum += area(x)
  print "total surface area = ", sum, " um2"
}

totalarea() // returns total surface area

func totalcm() { local tmp
  tmp = 0
  forall for (x,0) tmp += area(x)*cm(x)/10^8
  return tmp*10^6
}

print "Total Capacitance of cell is ", totalcm(), "pF"


endtemplate FoxP2


