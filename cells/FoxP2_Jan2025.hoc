objref all
proc subsets() { local i
    objref all
    all = new SectionList()
    soma     all.append()
    rad1     all.append()
    rad2     all.append()
    ori1     all.append()
    ori2     all.append()
    //radProx1 all.append()
    //radMed1  all.append()
    //radDist1 all.append()
    //lmM1     all.append()
    //lmt1     all.append()
